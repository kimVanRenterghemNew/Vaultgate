{
  "name": "vaultgate",
  "version": "0.0.1-beta.0",
  "private": false,
  "type": "module",
  "description": "Credential-proxy met beheerportaal: geen secrets in LLM-tools",
  "license": "GPL-3.0-or-later",
  "bin": {
    "vaultgate": "./bin/vaultgate.js"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "web/portal/portal.generated.js",
    "web/portal/touch.generated.js",
    "web/portal/portal.generated.css",
    "web/portal/fonts",
    "i18n"
  ],
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "check": "npm run lint && npm run test:coverage",
    "lint:report": "eslint . --format json --output-file outputs/lint/eslint.json",
    "screenshots": "node docs/probes/screenshots.mjs",
    "look": "node scripts/look.mjs",
    "skill": "node scripts/generate-skill.mjs",
    "build:css": "tailwindcss -i web/portal/portal.css -o web/portal/portal.generated.css --minify",
    "build:ui": "esbuild web/portal/index.js --bundle --format=iife --loader:.html=text --charset=utf8 --minify --tree-shaking=true --outfile=web/portal/portal.generated.js && esbuild web/portal/touch/index.js --bundle --format=iife --loader:.html=text --charset=utf8 --minify --tree-shaking=true --outfile=web/portal/touch.generated.js",
    "build": "npm run skill && npm run build:ui && npm run build:css",
    "mock-upstream": "node scripts/mock-provider.mjs",
    "e2e": "vitest run --project journey",
    "demo": "node scripts/demo.mjs",
    "demo:watch": "node scripts/demo.mjs --watch",
    "attack": "node scripts/attack/cli.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "4.3.3",
    "@vitest/coverage-v8": "^5.0.1",
    "daisyui": "5.7.47",
    "esbuild": "0.28.2",
    "eslint": "^10.15.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "playwright": "1.64.0",
    "tailwindcss": "4.3.3",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.0.3",
    "sodium-native": "5.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
